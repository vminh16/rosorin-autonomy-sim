<?xml version="1.0" encoding="utf-8" ?>
<!--
  IMU of the ROSOrin Pro simulation. Copy of robot_gazebo/urdf/imu.gazebo.xacro (Hiwonder, V1.0.0
  2025-05-29): same link, topic and 50 Hz rate. Change: with realism:=true the readings get noise and
  a gyro bias.
  - accelerometer: stddev 0.02 m/s^2, from the covariance the real driver reports (0.0004, wiki 2.1.4.2)
  - gyroscope: stddev 0.0013 rad/s (QMI8658 noise density 15 mdps/sqrt(Hz) at 25 Hz bandwidth; the
    wiki's resting sample reads about 0.001 rad/s), bias drawn once with stddev 0.0005 rad/s (residual
    after the 6-position calibration of wiki 2.1.1; the wiki gives no number, this is an assumption)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_imu">
  <xacro:arg name="realism" default="false"/>

  <xacro:macro name="axis_noise" params="axis stddev bias">
    <xacro:element xacro:name="${axis}">
      <noise type="gaussian">
        <mean>0</mean>
        <stddev>${stddev}</stddev>
        <bias_mean>0</bias_mean>
        <bias_stddev>${bias}</bias_stddev>
      </noise>
    </xacro:element>
  </xacro:macro>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <visualize>true</visualize>
      <topic>imu</topic>
      <xacro:if value="$(arg realism)">
        <imu>
          <angular_velocity>
            <xacro:axis_noise axis="x" stddev="0.0013" bias="0.0005"/>
            <xacro:axis_noise axis="y" stddev="0.0013" bias="0.0005"/>
            <xacro:axis_noise axis="z" stddev="0.0013" bias="0.0005"/>
          </angular_velocity>
          <linear_acceleration>
            <xacro:axis_noise axis="x" stddev="0.02" bias="0"/>
            <xacro:axis_noise axis="y" stddev="0.02" bias="0"/>
            <xacro:axis_noise axis="z" stddev="0.02" bias="0"/>
          </linear_acceleration>
        </imu>
      </xacro:if>
    </sensor>
  </gazebo>
</robot>
