<?xml version="1.0" encoding="utf-8"?>
<!--
  ROSOrin Pro simulation model (Ignition Gazebo Fortress).
  Fixed copy of robot_gazebo/urdf/robot.gazebo.xacro (Hiwonder, V1.0.0 2025-05-29). The robot body
  (rosorin_body.xacro, a copy of rosorin_description/urdf/rosorin.xacro without the fixed wheel
  visuals) keeps the CAD masses and collisions. Changes, with the evidence for each
  in docs/wiki_findings/ and test/test_sim_fidelity.py:
  - MecanumDrive uses the wiki constants: wheel_radius 0.04, wheel_separation 0.17706,
    wheelbase 0.17165 (upstream 0.05 / 0.34 / 0.30 disagreed with the simulated wheels:
    forward speed came out at 0.8x the command and turning at 1.5x)
  - IMU sensor included (upstream loaded the plugin but never declared the sensor, ISSUE-011);
    imu.gazebo.xacro adds noise with realism:=true
  - sensors and wheels: see lidar.gazebo.xacro, camera.gazebo.xacro, wheel.xacro
  - PlanarDrive (rosorin_gazebo_plugins) moves the body: holonomic twist tracking, sideways
    included, with the force capped by wheel traction. It replaced VelocityControl, which pushed
    with unlimited force, climbed furniture and flew off once tilted (ISSUE-016). Wheels are
    frictionless and only spin (see wheel.xacro for why)
  - total mass about 3.1 kg: the CAD body weighs 0.4 kg, so a 2.4 kg ballast link is added at
    the centre (retail figure for the Standard kit, the wiki does not give a mass)
  - removed the ign_ros2_control plugin (the URDF has no <ros2_control> tag, see ISSUE-009)
  - colours of the real robot (appearance.xacro); the turning wheels show the mecanum mesh
  - Pro upper part (deck, arm, screen) drawn from the wiki photo, camera on the wrist (pro_upper.xacro)
-->
<robot name="robot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="sim_ign" default="true"/>
  <xacro:arg name="realism" default="false"/>  <!-- sensor noise (imu, lidar xacros) -->
  <xacro:arg name="depth" default="false"/>    <!-- RGB-D camera (camera.gazebo.xacro) -->

  <xacro:include filename="$(find rosorin_navigation)/urdf/rosorin_body.xacro"/>
  <xacro:include filename="$(find rosorin_navigation)/urdf/wheel.xacro"/>
  <xacro:include filename="$(find rosorin_navigation)/urdf/lidar.gazebo.xacro"/>
  <xacro:include filename="$(find rosorin_navigation)/urdf/camera.gazebo.xacro"/>
  <xacro:include filename="$(find rosorin_navigation)/urdf/imu.gazebo.xacro"/>
  <xacro:include filename="$(find rosorin_navigation)/urdf/pro_upper.xacro"/>
  <xacro:include filename="$(find rosorin_navigation)/urdf/appearance.xacro"/>

  <!-- mass the CAD model lacks (battery, controller, arm, screen) -->
  <link name="ballast_link">
    <inertial>
      <mass value="2.4"/>
      <inertia ixx="0.00706" ixy="0" ixz="0" iyy="0.01378" iyz="0" izz="0.01828"/>
    </inertial>
  </link>
  <joint name="ballast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ballast_link"/>
    <origin xyz="0 0 0.05"/>
  </joint>

  <gazebo>
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <!-- /odom and TF odom -> base_footprint, 50 Hz as the real odom_publisher.
         NOTE: this is the true pose from the physics engine (no drift or noise). -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <tf_topic>/odom/tf</tf_topic>
    </plugin>

    <!-- drive: horizontal force and yaw torque tracking /controller/cmd_vel, capped by the wheel
         traction mu*m*g (rosorin_gazebo_plugins, ISSUE-016); gravity, roll and pitch stay physical.
         MecanumDrive below only spins the wheels. -->
    <plugin filename="rosorin_planar_drive" name="rosorin::PlanarDrive">
      <topic>/controller/cmd_vel</topic>
      <traction_coefficient>0.6</traction_coefficient>
      <lever_arm>0.174355</lever_arm>
      <time_constant>0.1</time_constant>
      <max_tilt>0.5</max_tilt>
      <wheel_radius>0.04</wheel_radius>
      <!-- motor no-load speed 110 rpm (wiki 1.10.2.3): no wheel turns faster -->
      <max_wheel_speed>11.519</max_wheel_speed>
    </plugin>

    <plugin filename="ignition-gazebo-mecanum-drive-system"
            name="ignition::gazebo::systems::MecanumDrive">
      <front_left_joint>front_left_joint</front_left_joint>
      <front_right_joint>front_right_joint</front_right_joint>
      <back_left_joint>rear_left_joint</back_left_joint>
      <back_right_joint>rear_right_joint</back_right_joint>
      <wheel_separation>0.17706</wheel_separation>
      <wheelbase>0.17165</wheelbase>
      <wheel_radius>0.04</wheel_radius>
      <topic>/controller/cmd_vel</topic>
      <!-- wheel odometry kept off /odom: the wheels spin freely, so when the robot is blocked this
           odometry keeps moving; on /odom it interleaved with OdometryPublisher (ISSUE-016) -->
      <odom_topic>/model/rosorin/wheel_odom</odom_topic>
      <tf_topic>/model/rosorin/wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>
</robot>
