<?xml version="1.0" encoding="utf-8" ?>
<!--
  Camera of the ROSOrin Pro simulation: colour stream of the Aurora930, wiki 1.10.4.
  Fixed copy of robot_gazebo/urdf/camera.gazebo.xacro. Changes:
  - horizontal FOV 74 degrees (1.2915 rad), 640x400 gives 51 degrees vertical: the robot manual
    value (the Aurora930 wiki says 71 x 46); upstream used 60 degrees
  - 12 Hz as the real camera (upstream 30 Hz, which also costs rendering time)
  Not simulated: the depth and IR streams (the sensor here is an RGB camera only).
-->
<robot name="camera_gazebo" xmlns:xacro="http://ros.org/wiki/xacro">
  <gazebo reference="camera_link0">
    <sensor name="robot_cam" type="camera">
      <camera>
        <horizontal_fov>1.2915</horizontal_fov>
        <image>
          <width>640</width>
          <height>400</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>12</update_rate>
      <visualize>true</visualize>
      <camera_info_topic>/depth_cam/rgb/camera_info</camera_info_topic>
      <topic>/depth_cam/depth_cam</topic>
      <enable_metrics>true</enable_metrics>
    </sensor>
  </gazebo>
</robot>
