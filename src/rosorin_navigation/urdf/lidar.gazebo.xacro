<?xml version="1.0"?>
<!--
  LiDAR of the ROSOrin Pro simulation: COIN-D6 as in the Hiwonder wiki 1.10.5.
  Fixed copy of robot_gazebo/urdf/lidar.gazebo.xacro. Changes:
  - 360 degrees, 400 samples (0.9 degrees), as the real COIN-D6 (upstream: 156 degrees, 270 samples;
    the vendor's own Gazebo chapter shows that value, the real sensor does not)
  - rate 10 Hz, range 0.15 - 12 m unchanged (wiki: default 10 Hz, 12 m on black objects)
  - realism:=true: no noise here; the scan_noise node adds the range-dependent noise of the COIN-D6
    and publishes /scan (Gazebo's scan is bridged as /scan_raw, as on the real robot)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gpu_lidar">
  <xacro:arg name="realism" default="false"/>
  <gazebo reference="lidar_frame">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <ignition_frame_id>lidar_frame</ignition_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.12588</max_angle>  <!-- pi - 2*pi/400: 400 beams, no duplicate at +-pi -->
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${0.0 if '$(arg realism)' == 'true' else 0.01}</stddev>
        </noise>
      </ray>
      <alwaysOn>1</alwaysOn>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
</robot>
