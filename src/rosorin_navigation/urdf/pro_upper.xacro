<?xml version="1.0"?>
<!--
  Upper part of the ROSOrin Pro that the Hiwonder CAD does not contain: top deck, 6DOF arm in the
  pose of the wiki product photo (chapter 1.2, "Install the Depth Camera"), Aurora930 on the wrist and
  the 7-inch screen. Visual only: no collision, no mass (the arm, screen and battery are already in
  ballast_link of rosorin_sim.urdf.xacro), and every part is above the LiDAR plane (0.164 m), so /scan
  is unchanged.

  Sizes: HX-12H servo 35.19 x 26.19 x 27.20 mm (wiki 1.10.2.4), Aurora930 76.5 x 20.7 x 21.8 mm
  (wiki 1.10.4, vendor mesh), 7-inch screen. Link lengths, deck height and joint angles are NOT in the
  wiki: estimated from the photo with the 80 mm wheel as scale (about +-1 cm).

  camera_link0 (the RGB camera sensor, camera.gazebo.xacro) is defined here on the wrist, where the real
  camera is mounted; the Hiwonder model put it on the chassis front (that is the non-Pro ROSOrin).
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="SERVO" value="0.0272 0.0352 0.0262"/>   <!-- x y z, axis along y -->

  <xacro:macro name="part" params="link parent xyz rpy">
    <link name="${link}"/>
    <joint name="${link}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${link}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- one visual box / cylinder in an existing link; colour set in a gazebo block below -->
  <xacro:macro name="box" params="link name size xyz rpy:='0 0 0' rgb">
    <link name="${link}_${name}">
      <visual>
        <geometry><box size="${size}"/></geometry>
        <material name="${link}_${name}"><color rgba="${rgb} 1"/></material>
      </visual>
    </link>
    <joint name="${link}_${name}_joint" type="fixed">
      <parent link="${link}"/>
      <child link="${link}_${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="cyl" params="link name r l xyz rpy:='0 0 0' rgb">
    <link name="${link}_${name}">
      <visual>
        <geometry><cylinder radius="${r}" length="${l}"/></geometry>
        <material name="${link}_${name}"><color rgba="${rgb} 1"/></material>
      </visual>
    </link>
    <joint name="${link}_${name}_joint" type="fixed">
      <parent link="${link}"/>
      <child link="${link}_${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:property name="SILVER" value="0.80 0.81 0.83"/>
  <xacro:property name="BLACK" value="0.06 0.06 0.07"/>
  <xacro:property name="BRASS" value="0.72 0.58 0.30"/>

  <!-- top deck, 3 mm plate, bottom at 0.176 m (LiDAR head ends at 0.170 m) -->
  <xacro:part link="pro_deck" parent="base_link" xyz="0.005 0 0.1495" rpy="0 0 0"/>
  <xacro:box link="pro_deck" name="plate" size="0.24 0.15 0.003" xyz="0 0 0" rgb="${SILVER}"/>
  <!-- controller box between screen and arm (black box in the photo) -->
  <xacro:box link="pro_deck" name="computer" size="0.07 0.09 0.035" xyz="-0.02 0 0.019" rgb="${BLACK}"/>

  <!-- arm turret on the front of the deck: base servo inside four brass standoffs, turntable on top -->
  <xacro:part link="pro_turret" parent="pro_deck" xyz="0.065 0 0.0015" rpy="0 0 0"/>
  <xacro:box link="pro_turret" name="servo" size="${SERVO}" xyz="0 0 0.02" rpy="0 0 1.5708" rgb="${BLACK}"/>
  <xacro:cyl link="pro_turret" name="post1" r="0.0025" l="0.06" xyz="0.025 0.025 0.03" rgb="${BRASS}"/>
  <xacro:cyl link="pro_turret" name="post2" r="0.0025" l="0.06" xyz="0.025 -0.025 0.03" rgb="${BRASS}"/>
  <xacro:cyl link="pro_turret" name="post3" r="0.0025" l="0.06" xyz="-0.025 0.025 0.03" rgb="${BRASS}"/>
  <xacro:cyl link="pro_turret" name="post4" r="0.0025" l="0.06" xyz="-0.025 -0.025 0.03" rgb="${BRASS}"/>
  <xacro:cyl link="pro_turret" name="plate" r="0.042" l="0.004" xyz="0 0 0.062" rgb="${SILVER}"/>
  <xacro:cyl link="pro_turret" name="turntable" r="0.036" l="0.008" xyz="0 0 0.068" rgb="${BLACK}"/>

  <!-- shoulder: servo on the turntable, link 1 leans slightly back -->
  <xacro:part link="pro_shoulder" parent="pro_turret" xyz="0 0 0.072" rpy="0 -0.25 0"/>
  <xacro:box link="pro_shoulder" name="servo" size="${SERVO}" xyz="0 0 0.016" rgb="${BLACK}"/>
  <xacro:box link="pro_shoulder" name="bracket_l" size="0.03 0.003 0.10" xyz="0 0.0205 0.06" rgb="${SILVER}"/>
  <xacro:box link="pro_shoulder" name="bracket_r" size="0.03 0.003 0.10" xyz="0 -0.0205 0.06" rgb="${SILVER}"/>

  <!-- elbow: servo, link 2 leans forward -->
  <xacro:part link="pro_elbow" parent="pro_shoulder" xyz="0 0 0.105" rpy="0 0.85 0"/>
  <xacro:box link="pro_elbow" name="servo" size="${SERVO}" xyz="0 0 0.012" rgb="${BLACK}"/>
  <xacro:box link="pro_elbow" name="bracket_l" size="0.03 0.003 0.095" xyz="0 0.0205 0.05" rgb="${SILVER}"/>
  <xacro:box link="pro_elbow" name="bracket_r" size="0.03 0.003 0.095" xyz="0 -0.0205 0.05" rgb="${SILVER}"/>

  <!-- wrist: two servos and the gripper, pointing forward and slightly down -->
  <xacro:part link="pro_wrist" parent="pro_elbow" xyz="0 0 0.10" rpy="0 1.3 0"/>
  <xacro:box link="pro_wrist" name="servo" size="${SERVO}" xyz="0 0 0.012" rgb="${BLACK}"/>
  <xacro:box link="pro_wrist" name="servo2" size="${SERVO}" xyz="0 0 0.042" rpy="0 0 1.5708" rgb="${BLACK}"/>
  <xacro:box link="pro_wrist" name="palm" size="0.012 0.05 0.02" xyz="0 0 0.064" rgb="${SILVER}"/>
  <xacro:box link="pro_wrist" name="finger_l" size="0.008 0.012 0.05" xyz="0 0.018 0.095" rgb="${BLACK}"/>
  <xacro:box link="pro_wrist" name="finger_r" size="0.008 0.012 0.05" xyz="0 -0.018 0.095" rgb="${BLACK}"/>
  <xacro:box link="pro_wrist" name="cam_bracket" size="0.02 0.05 0.03" xyz="-0.028 0 0.03" rgb="${SILVER}"/>

  <!-- Aurora930 on top of the wrist, looking forward and 0.25 rad down (camera x axis = view) -->
  <link name="camera_link0">
    <visual>
      <geometry>
        <mesh filename="file://$(find rosorin_description)/meshes/depth_camera_link.stl"/>
      </geometry>
      <material name="aurora"><color rgba="0.86 0.87 0.89 1"/></material>
    </visual>
  </link>
  <joint name="depth_camera" type="fixed">
    <parent link="pro_wrist"/>
    <child link="camera_link0"/>
    <origin xyz="-0.05 0 0.03" rpy="0 -1.65 0"/>
  </joint>

  <!-- 7-inch screen at the rear, display facing backwards, leaning back like a laptop lid -->
  <xacro:part link="pro_screen" parent="pro_deck" xyz="-0.085 0 0.075" rpy="0 -0.6 0"/>
  <xacro:box link="pro_screen" name="panel" size="0.012 0.172 0.108" xyz="0 0 0" rgb="${BLACK}"/>
  <xacro:box link="pro_screen" name="stand" size="0.006 0.05 0.04" xyz="0.012 0 -0.05" rpy="0 0.6 0" rgb="${BLACK}"/>

</robot>
