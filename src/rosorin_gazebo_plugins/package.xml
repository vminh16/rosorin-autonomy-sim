<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosorin_gazebo_plugins</name>
  <version>0.0.0</version>
  <description>Ignition Gazebo (Fortress) system plugins for the ROSOrin Pro simulation: traction-limited planar drive</description>
  <maintainer email="minhsctn1608@gmail.com">minh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ignition-gazebo6</depend>
  <depend>ignition-plugin</depend>
  <depend>ignition-transport11</depend>
  <depend>ignition-msgs8</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
